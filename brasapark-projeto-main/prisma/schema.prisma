// 1. Definição da conexão com o banco (adicione isso no topo)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 2. Definição do gerador do cliente Prisma (adicione isso também)
generator client {
  provider = "prisma-client-js"
}

// 3. Seus modelos (que já estão certinhos)
model Atracao {
  id         Int       @id @default(autoincrement())
  nome       String
  descricao  String?
  tipo       String
  alturaMin  Int
  capacidade Int
  status     String    @default("Ativa")

  clientes   Cliente[]
}

model Cliente {
  id        Int     @id @default(autoincrement())
  nome      String
  email     String  @unique
  telefone  String

  atracaoId Int
  atracao   Atracao @relation(fields: [atracaoId], references: [id], onDelete: Cascade)
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  imagem       UserImage?
}

model UserImage {
  id           Int      @id @default(autoincrement())
  caminho      String
  mimeType     String
  tamanho      Int
  nomeOriginal String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}
