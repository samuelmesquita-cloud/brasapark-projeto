@baseUrl = http://localhost:3000

### 1. Login para obter o token
# Execute o seed antes. Usuario: admin@brasapark.com / 123456
# @name loginUpload
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@brasapark.com",
  "senha": "123456"
}

@uploadToken = {{loginUpload.response.body.$.token}}

### 2. Envio sem autenticacao
# Esperado: 401. O authMiddleware roda antes do Multer, portanto nada e salvo.
POST {{baseUrl}}/api/users/image
Content-Type: multipart/form-data; boundary=BrasaBoundary

--BrasaBoundary
Content-Disposition: form-data; name="image"; filename="logo.png"
Content-Type: image/png

< ../frontend/logo.png
--BrasaBoundary--

### 3. Envio valido
# Esperado: 201, path publico e replaced false no primeiro envio.
# @name uploadValido
POST {{baseUrl}}/api/users/image
Authorization: Bearer {{uploadToken}}
Content-Type: multipart/form-data; boundary=BrasaBoundary

--BrasaBoundary
Content-Disposition: form-data; name="image"; filename="logo.png"
Content-Type: image/png

< ../frontend/logo.png
--BrasaBoundary--

### 4. Abrir o caminho publico devolvido
# Esperado: 200 e a imagem aparece na janela de resposta do REST Client.
GET {{baseUrl}}{{uploadValido.response.body.$.path}}

### 5. Arquivo maior que 2 MB
# O video e enviado com MIME image/png apenas para exercitar o limite de tamanho.
# Esperado: 400 com code LIMIT_FILE_SIZE e nenhum arquivo gravado.
POST {{baseUrl}}/api/users/image
Authorization: Bearer {{uploadToken}}
Content-Type: multipart/form-data; boundary=BrasaBoundary

--BrasaBoundary
Content-Disposition: form-data; name="image"; filename="grande.png"
Content-Type: image/png

< ../frontend/video.mp4
--BrasaBoundary--

### 6. Tipo nao permitido
# Esperado: 400 e nenhum arquivo gravado.
POST {{baseUrl}}/api/users/image
Authorization: Bearer {{uploadToken}}
Content-Type: multipart/form-data; boundary=BrasaBoundary

--BrasaBoundary
Content-Disposition: form-data; name="image"; filename="arquivo.txt"
Content-Type: text/plain

< ../README.md
--BrasaBoundary--

### 7. Reenvio pelo mesmo usuario
# Esperado: 201, replaced true e um novo path. O arquivo anterior e removido.
# @name uploadAtualizado
PUT {{baseUrl}}/api/users/image
Authorization: Bearer {{uploadToken}}
Content-Type: multipart/form-data; boundary=BrasaBoundary

--BrasaBoundary
Content-Disposition: form-data; name="image"; filename="novo-avatar.png"
Content-Type: image/png

< ../frontend/logo.png
--BrasaBoundary--

### 8. Consultar o unico registro de imagem do usuario
# Esperado: 200 e caminho igual ao retornado no reenvio.
GET {{baseUrl}}/api/users/image
Authorization: Bearer {{uploadToken}}
